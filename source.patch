+HorusView::HorusView(NavigationView& nav)
+    : nav_{nav} {
+    constexpr portapack::spi_flash::image_tag_t tag{'P', 'H', 'V', '3'};
+    baseband::run_image(tag);
+
+    add_children({&labels,
+                  &field_frequency,
+                  &field_rf_amp,
+                  &field_lna,
+                  &field_vga,
+                  &rssi,
+                  &channel,
+                  &field_volume,
+                  &check_log,
+                  &check_crc,
+                  &text_signature,
+                  &text_serial,
+                  &text_timestamp,
+                  &text_voltage,
+                  &text_frame,
+                  &text_temp,
+                  &text_humid,
+                  &text_press,
+                  &text_vspeed,
+                  &geopos,
+                  &button_see_qr,
+                  &button_see_map});
+
+    field_frequency.set_step(50);
+
+    geopos.set_read_only(true);
+
+    check_log.set_value(logging);
+    check_log.on_select = [this](Checkbox&, bool v) {
+        logging = v;
+    };
+
+    field_frequency.updated = [this](rf::Frequency) {
+        baseband::set_rtty_config(10000, 270);
+        position_received_ = false;
+        last_timestamp_update_ = 0;
+        text_signature.set("Waiting...");
+        text_serial.set("--");
+        text_timestamp.set("--");
+        check_crc.set("CRC --");
+    };
+
+    receiver_model.enable();
+
+    // QR code with geo URI
+    button_see_qr.on_select = [this, &nav](Button&) {
+        if (!position_received_) return;
+        std::string geo_uri = "geo:" + to_string_decimal(geopos.lat(), 5) + "," + to_string_decimal(geopos.lon(), 5);  // 5 decimal digits for ~1 meter accuracy
+        nav.push<QRCodeView>(geo_uri.data());
+    };
+
+    button_see_map.on_select = [this, &nav](Button&) {
+        if (!position_received_) return;
+        geomap_view_ = nav.push<GeoMapView>(
+            sonde_id,
+            geopos.altitude(),
+            GeoPos::alt_unit::METERS,
+            GeoPos::spd_unit::HIDDEN,
+            geopos.lat(),
+            geopos.lon(),
+            999);  // set a dummy heading out of range to draw a cross...probably not ideal?
+        nav.set_on_pop([this]() {
+            geomap_view_ = nullptr;
+        });
+    };
+
+    log_file.append(logs_dir / u"HORUS_" + to_string_timestamp(rtc_time::now()) + u".TXT");
+    check_crc.set("CRC --");
+    text_signature.set("Waiting...");
+    text_voltage.set("--");
+    text_temp.set("--");
+    text_humid.set("--");
+    text_press.set("--");
+    text_vspeed.set("--");
+
+    if (pmem::beep_on_packets()) {
+        audio::set_rate(audio::Rate::Hz_24000);
+        audio::output::start();
+    }
+
+    // inject a PitchRSSIConfigureMessage in order to arm
+    // the pitch rssi events that will be used by the
+    // processor:
+    const PitchRSSIConfigureMessage message{true, 0};
+
+    shared_memory.application_queue.push(message);
+
+    baseband::set_pitch_rssi(0, true);
+}
+
+HorusView::~HorusView() {
+    baseband::set_pitch_rssi(0, false);
+
+    receiver_model.disable();
+    baseband::shutdown();
+    audio::output::stop();
+}
+
+void HorusView::on_gps(const GPSPosDataMessage* msg) {
+    if (!geomap_view_)
+        return;
+    geomap_view_->update_my_position(msg->lat, msg->lon, msg->altitude);
+}
+void HorusView::on_orientation(const OrientationDataMessage* msg) {
+    if (!geomap_view_)
+        return;
+    geomap_view_->update_my_orientation(msg->angle, true);
+}
+
+void HorusView::focus() {
+    field_frequency.focus();
+}
+
+void HorusView::on_packet(const RTTYDataMessage& message) {
+    if (message.data_len != sizeof(horus::Position)) return;
+    horus::Position p{};
+    memcpy(&p, message.data, sizeof(p));
+    p.callsign[15] = 0;
+    sonde_id = p.callsign;
+    text_signature.set("Horus V3");
+    text_serial.set(sonde_id);
+    check_crc.set("CRC OK");
+    text_frame.set(to_string_dec_uint(p.sequence));
+    text_timestamp.set(p.seconds >= 0 && p.seconds < 86400 ? to_string_dec_uint(p.seconds / 3600, 2, '0') + ":" + to_string_dec_uint(p.seconds / 60 % 60, 2, '0') + ":" + to_string_dec_uint(p.seconds % 60, 2, '0') + " UTC" : "--");
+    text_voltage.set(p.fields & 1 ? to_string_decimal(p.millivolts / 1000.0f, 2) + "V" : "--");
+    text_temp.set(p.fields & 2 ? to_string_decimal(p.temperature / 10.0f, 1) + STR_DEGREES_C : "--");
+    text_humid.set(p.fields & 4 ? to_string_dec_uint(p.humidity) + "%" : "--");
+    text_press.set(p.fields & 8 ? to_string_decimal(p.pressure / 10.0f, 1) + " hPa" : "--");
+    if (p.fields & 16) text_vspeed.set(to_string_decimal(p.ascent / 100.0f, 1) + " m/s");
+    const bool valid = (p.latitude != 0 || p.longitude != 0) && p.altitude != -1000;
+    if (valid) {
+        const auto now = rtc_time::rtcToUnixUTC(rtc_time::now());
+        if (!(p.fields & 16) && last_timestamp_update_ && now - last_timestamp_update_ >= 10)
+            text_vspeed.set(to_string_decimal((p.altitude - last_altitude_) / float(now - last_timestamp_update_), 1) + " m/s");
+        if (!last_timestamp_update_ || now - last_timestamp_update_ >= 10) {
+            last_timestamp_update_ = now;
+            last_altitude_ = p.altitude;
+        }
+        const float lat = p.latitude / 100000.0f, lon = p.longitude / 100000.0f;
+        geopos.set_altitude(p.altitude);
+        geopos.set_lat(lat);
+        geopos.set_lon(lon);
+        position_received_ = true;
+        if (geomap_view_) geomap_view_->update_position(lat, lon, 400, p.altitude, 0);
+    }
+    if (logging) {
+        log_file.write_entry(rtc_time::now(), sonde_id + "," + to_string_dec_uint(p.sequence) + "," + to_string_dec_int(p.seconds) + "," +
+                                                  to_string_decimal(p.latitude / 100000.0f, 5) + "," + to_string_decimal(p.longitude / 100000.0f, 5) + "," + to_string_dec_int(p.altitude));
+    }
+    if (pmem::beep_on_packets()) baseband::request_rssi_beep();
+}
+
+void HorusView::on_freqchg(int64_t freq) {
+    field_frequency.set_value(freq);
+}
+
+}  // namespace ui::external_app::horus_rx
