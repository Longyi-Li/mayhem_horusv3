+
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "proc_horus.hpp"
+#include "portapack_shared_memory.hpp"
+#include "event_m4.hpp"
+#include <string.h>
+#include "audio_dma.hpp"
+
+HorusProcessor::HorusProcessor() {
+    decim_0.configure(taps_11k0_decim_0.taps);
+    decim_1.configure(taps_11k0_decim_1.taps);
+    baseband_thread.start();
+}
+void HorusProcessor::execute(const buffer_c8_t& input) {
+    // The message loop and DSP run on different ChibiOS threads. Reset only
+    // here, at a sample-block boundary, never from the message-loop thread.
+    if (reset_requested_.exchange(false, std::memory_order_relaxed)) decoder_.reset();
+    const buffer_c16_t target{buffer_.data(), buffer_.size()};
+    const auto first = decim_0.execute(input, target);
+    const auto channel = decim_1.execute(first, target);  // Stock Radiosonde path: 38400 complex samples/s
+    feed_channel_stats(channel);
+    for (size_t n = 0; n < channel.count; ++n) {
+        decoder_.sample_radio_38400(channel.p[n].real(), channel.p[n].imag());
+    }
+}
+void HorusProcessor::received(const horus::Position& position, void*) {
+    // Existing n_261025 IPC envelope, with an app-local binary payload.
+    // No new Message ID or stock firmware changes are required at runtime.
+    RTTYDataMessage message{};
+    static_assert(sizeof(position) <= sizeof(message.data), "IPC payload size");
+    memcpy(message.data, &position, sizeof(position));
+    message.data_len = sizeof(position);
+    shared_memory.application_queue.push(message);
+}
+void HorusProcessor::on_message(const Message* const msg) {
+    switch (msg->id) {
+        case Message::ID::RTTYData:
+            reset_requested_.store(true, std::memory_order_relaxed);
+            break;
+        case Message::ID::RequestSignal:
+            on_signal_message(*reinterpret_cast<const RequestSignalMessage*>(msg));
+            break;
+
+        case Message::ID::AudioBeep:
+            on_beep_message(*reinterpret_cast<const AudioBeepMessage*>(msg));
+            break;
+
+        case Message::ID::PitchRSSIConfigure:
+            on_pitch_rssi_config(*reinterpret_cast<const PitchRSSIConfigureMessage*>(msg));
+            break;
+
+        default:
+            break;
+    }
+}
+
+void HorusProcessor::on_signal_message(const RequestSignalMessage& message) {
+    if (message.signal == RequestSignalMessage::Signal::RSSIBeepRequest) {
+        float rssi_ratio = (float)last_rssi / RSSI_CEILING;
+        uint32_t beep_duration = 0;
+
+        if (rssi_ratio <= PROPORTIONAL_BEEP_THRES) {
+            beep_duration = BEEP_MIN_DURATION;
+        } else if (rssi_ratio < 1) {
+            beep_duration = rssi_ratio * BEEP_DURATION_RANGE + BEEP_MIN_DURATION;
+        } else {
+            beep_duration = BEEP_DURATION_RANGE + BEEP_MIN_DURATION;
+        }
+
+        audio::dma::beep_start(beep_freq, DEFAULT_AUDIO_SAMPLE_RATE, beep_duration);
+    }
+}
+
+void HorusProcessor::on_beep_message(const AudioBeepMessage& message) {
+    audio::dma::beep_start(message.freq, message.sample_rate, message.duration_ms);
+}
+
+void HorusProcessor::on_pitch_rssi_config(const PitchRSSIConfigureMessage& message) {
+    pitch_rssi_enabled = message.enabled;
+
+    beep_freq = message.rssi * RSSI_PITCH_WEIGHT + BEEP_BASE_FREQ;
+    last_rssi = message.rssi;
+}
+
+int main() {
+    audio::dma::init_audio_out();
+    EventDispatcher dispatcher{std::make_unique<HorusProcessor>()};
+    dispatcher.run();
+    return 0;
+}
