+class Bits {
+   public:
+    Bits(const uint8_t* data, size_t bytes)
+        : data_(data), end_(bytes * 8) {}
+    uint32_t get(unsigned count) {
+        if (pos_ + count > end_) {
+            valid = false;
+            return 0;
+        }
+        uint32_t value = 0;
+        while (count--) {
+            value = (value << 1) | ((data_[pos_ / 8] >> (7 - pos_ % 8)) & 1);
+            ++pos_;
+        }
+        return value;
+    }
+    bool valid{true};
+
+   private:
+    const uint8_t* data_;
+    size_t pos_{}, end_;
+};
+}  // namespace
